# Copia este archivo como .env y completa los valores

# Clave secreta para sesiones y tokens de aprobación por correo (cámbiala)
SECRET_KEY=Nuvia2026**

# URL pública de la app (necesaria para los links de aprobación en correos)
BASE_URL=http://localhost:8000

# ---- Zoho OAuth (login de usuarios) ----
# Crea un cliente en https://api-console.zoho.com -> Server-based Applications
# Redirect URI autorizada: {BASE_URL}/auth/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Región de tu cuenta Zoho: com, eu, in, com.au, jp
ZOHO_REGION=com

# ---- Zoho Mail (envío de notificaciones) ----
# Crea un "Self Client" en https://api-console.zoho.com y genera un
# refresh token con scope: ZohoMail.messages.CREATE,ZohoMail.accounts.READ
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
# Remitente (debe ser una dirección válida de la cuenta Zoho Mail)
MAIL_FROM=notificaciones@nuviasmiles.com

# Correos de administradores iniciales (separados por coma)
ADMIN_EMAILS=oscaralmanza@nuviasmiles.com

# Base de datos
DATABASE_URL=sqlite:///./permisos.db
